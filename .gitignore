# Gradle / Android build output
.gradle/
build/
*/build/
local.properties
.kotlin/
*.apk
*.aab
*.iml
.idea/
captures/
# Keys must never be committed
*.pem
*.key
# Release signing material and env files must never be committed
*.jks
*.keystore
keystore.properties
signing.properties
.env
.env.*
# Local scratch space (one-off scripts, notes); never tracked
/scratch/
# Demo emulator state (AVD, host key, pane scripts); regenerated by demo/demo.py
/demo/.state/
